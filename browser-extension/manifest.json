{
  "manifest_version": 3,
  "name": "SAVR Flight Import",
  "version": "0.1.0",
  "description": "Import a selected Google Flights itinerary into SAVR Travel CRM.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://travel-crm-khaki.vercel.app/*",
    "https://travel-crm-savrtechnologieslimited-8832.vercel.app/*",
    "http://localhost:5173/*"
  ],
  "action": {
    "default_title": "Import selected flight",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://travel-crm-khaki.vercel.app/itinerary-builder*",
        "https://travel-crm-savrtechnologieslimited-8832.vercel.app/itinerary-builder*",
        "http://localhost:5173/itinerary-builder*"
      ],
      "js": ["crm-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
