# Server-side configuration only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRAVEL_PLANNER_MODEL=gpt-4.1-mini
OPENAI_TRAVEL_PLANNER_WEB_SEARCH=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Separate Next.js WACRM app URL. Use its Vercel HTTPS URL after deployment.
# Local development defaults to http://localhost:3000.
VITE_WACRM_APP_URL=http://localhost:3000
# Server-only; use the same random 32-byte secret in WACRM.
WACRM_BRIDGE_SECRET=
# Server-only credentials for read-only CRM access to WACRM conversation data.
# Use the WACRM Supabase project's URL and service_role key; never add VITE_.
WACRM_SUPABASE_URL=
WACRM_SUPABASE_SERVICE_ROLE_KEY=
# WACRM workspace linked to this CRM company (server-only UUID).
WACRM_ACCOUNT_ID=
# WACRM public API key with the messages:send scope; server-side only.
WACRM_API_KEY=
# Approved WACRM template with a single body placeholder {{1}} for the customer's name.
WACRM_GREETING_TEMPLATE_NAME=
WACRM_GREETING_TEMPLATE_LANGUAGE=en_US
# Required by the whatsapp-webhook Edge Function for Meta HMAC verification.
META_APP_SECRET=
# Browser-side document OCR does not require OCR credentials or localhost services.
# Deprecated legacy values retained only for optional server-side development fallback.
# PADDLE_OCR_URL=http://localhost:8001
# OCR_SERVICE_API_KEY=
OCR_MAX_FILE_SIZE_BYTES=10485760
OCR_TIMEOUT_SECONDS=45
GOOGLE_CLIENT_ID=940782278685-c7d2riti9f4j3g0n973sugq55kak3n3i.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/gmail
GOOGLE_MAPS_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/gmail
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_MAIL_API_URL=https://mail.zoho.in
ZOHO_REDIRECT_URI=http://localhost:5173/gmail
VITE_TRAVEL_HOTEL_SEARCH_URL=https://www.goibibo.com/hotels/
VITE_TRAVEL_FLIGHT_SEARCH_URL=https://www.goibibo.com/flights/
# Server-only SearchApi key for live one-way Google Flights results in the itinerary builder.
# Live search is optional; external flight and train provider links work without this key.
SEARCHAPI_API_KEY=
